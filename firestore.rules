rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128 && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sudharsanm014@gmail.com' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'main_admin'
      );
    }

    // --- USERS ROOT COLLECTION ---
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow update: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // --- FEEDBACK & TICKETS WITH ADMIN REPLIES ---
    match /feedback/{feedbackId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isValidId(feedbackId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isAdmin();
    }

    // --- BROADCAST NOTIFICATIONS (NEW FEATURE ALERTS) ---
    match /broadcast_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- NEWS & BLOG POSTS (PUBLIC READ, ADMIN WRITE) ---
    match /news_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
